[gd_scene format=3]

[ext_resource type="Script" path="res://hud.gd" id="1_hud"]
[ext_resource type="Script" path="res://joystick.gd" id="2_joystick"]

[node name="HUD" type="CanvasLayer"]
process_mode = 3
script = ExtResource("1_hud")

[node name="Joystick" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("2_joystick")

[node name="TopBar" type="MarginContainer" parent="."]
anchors_preset = 10
anchor_right = 1.0
offset_bottom = 100.0
grow_horizontal = 2
mouse_filter = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 20

[node name="Column" type="VBoxContainer" parent="TopBar"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 6

[node name="Row" type="HBoxContainer" parent="TopBar/Column"]
layout_mode = 2
mouse_filter = 2

[node name="Score" type="Label" parent="TopBar/Column/Row"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 8
theme_override_font_sizes/font_size = 28
text = "Deliveries: 0"

[node name="Task" type="Label" parent="TopBar/Column/Row"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 8
theme_override_font_sizes/font_size = 28
text = "Pick up a parcel"
horizontal_alignment = 1

[node name="Time" type="Label" parent="TopBar/Column/Row"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 8
theme_override_font_sizes/font_size = 28
text = "Time: 60"
horizontal_alignment = 2

[node name="Row2" type="HBoxContainer" parent="TopBar/Column"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 12

[node name="Cash" type="Label" parent="TopBar/Column/Row2"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 8
theme_override_font_sizes/font_size = 28
text = "Cash: 0"

[node name="FuelLabel" type="Label" parent="TopBar/Column/Row2"]
layout_mode = 2
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 8
theme_override_font_sizes/font_size = 28
text = "Fuel"

[node name="FuelBar" type="ProgressBar" parent="TopBar/Column/Row2"]
custom_minimum_size = Vector2(220, 22)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
value = 100.0
show_percentage = false

[node name="Menu" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.65)

[node name="Center" type="CenterContainer" parent="Menu"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Box" type="VBoxContainer" parent="Menu/Center"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="Menu/Center/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 56
text = "Last Mile"
horizontal_alignment = 1

[node name="Message" type="Label" parent="Menu/Center/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Message"
horizontal_alignment = 1

[node name="Wallet" type="Label" parent="Menu/Center/Box"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.3, 1)
theme_override_font_sizes/font_size = 24
text = "Cash: 0"
horizontal_alignment = 1

[node name="Shop" type="VBoxContainer" parent="Menu/Center/Box"]
custom_minimum_size = Vector2(560, 0)
layout_mode = 2
theme_override_constants/separation = 8

[node name="PlayButton" type="Button" parent="Menu/Center/Box"]
custom_minimum_size = Vector2(240, 72)
layout_mode = 2
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 30
text = "Play"
